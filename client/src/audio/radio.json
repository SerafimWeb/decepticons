    { "chave": "rd_intercepto_pinca_3", "canal": "intercepto", "situacao": "pinca", "estilo": "sujo", "texto": "Dois pelas bordas, um na frente. Ninguém atira até o sinal.", "gatilho": "cerebro:pinca" },
