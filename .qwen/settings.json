{
  "permissions": {
    "allow": [
      "Bash(rmdir *)",
      "Bash(git worktree *)",
      "Bash(git fetch origin)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(dir *)",
      "Bash(@find *)",
      "Bash(get-content *)",
      "Bash(.count)",
      "Bash(mklink *)",
      "Bash(npm run *)",
      "Bash(timeout 600 npm run *)",
      "Bash(git status)",
      "Bash(git status --short)",
      "Bash(git branch --list)",
      "Bash(git branch --show-current)",
      "Bash(git ls-remote --heads origin)",
      "Bash(git diff --stat)",
      "Bash(git diff --name-only)",
      "Bash(git merge origin/main)"
    ]
  },
  "$version": 4
}
