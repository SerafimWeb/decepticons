#!/usr/bin/env bash
# Protocolo Serafim UM — [M5] sem memória, sem commit + [R2/Skill 19] nada de secrets no git.
# Versionado em .githooks/; ativado pelo `npm install` (scripts/install-hooks.mjs).
MEMORY_DIR=".decepticons"
ESTADO="${MEMORY_DIR}/ESTADO_ATUAL.md"

if [ ! -f "$ESTADO" ]; then
  echo "❌ PROTOCOLO VIOLADO: $ESTADO não encontrado."
  exit 1
fi

# [M5] ESTADO_ATUAL entra neste commit ou já foi commitado hoje.
if ! git diff --cached --name-only | grep -qx "$ESTADO"; then
  LAST=$(git log -1 --format=%cs -- "$ESTADO" 2>/dev/null)
  if [ "$LAST" != "$(date +%Y-%m-%d)" ]; then
    echo "❌ PROTOCOLO VIOLADO [M5]: atualize $ESTADO antes de commitar."
    echo "   Edite o arquivo e rode: git add $ESTADO"
    exit 1
  fi
fi

# [R2] Arquivos de secret nunca entram no git (.env.example é permitido).
SECRET_FILES=$(git diff --cached --name-only --diff-filter=ACR \
  | grep -E '(^|/)\.env(\..+)?$|\.(pem|key|p12|pfx)$' | grep -v '\.env\.example$')
if [ -n "$SECRET_FILES" ]; then
  echo "❌ PROTOCOLO VIOLADO [R2]: arquivo de secret no stage:"
  echo "$SECRET_FILES" | sed 's/^/   /'
  exit 1
fi

# [Skill 19] Formatos de chave conhecidos nas linhas adicionadas.
if git diff --cached -U0 --diff-filter=ACM | grep -E '^\+[^+]' \
  | grep -Eq 'sk_live_[0-9A-Za-z]{10,}|-----BEGIN [A-Z ]*PRIVATE KEY-----|ghp_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{30,}|AKIA[0-9A-Z]{16}|eyJ[A-Za-z0-9_-]{20,}\.eyJ[A-Za-z0-9_-]{20,}\.'; then
  echo "❌ PROTOCOLO VIOLADO [R2]: possível secret no diff. Revise com: git diff --cached"
  exit 1
fi

exit 0
