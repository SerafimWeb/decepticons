{
  "name": "cybermech",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "smoke": "node scripts/smoke.mjs",
    "smoke:dev": "node scripts/smoke.mjs --dev",
    "check": "npm run typecheck && npm test && node scripts/painel.mjs --check && vite build && npm run smoke && npm run mech:bocas && node scripts/site.mjs --check",
    "prepare": "node scripts/install-hooks.mjs",
    "test": "node scripts/test.mjs",
    "publicar": "node scripts/publicar.mjs",
    "arquivar": "node scripts/arquivar-docs.mjs",
    "mesa": "node scripts/mesa.mjs",
    "gh": "node scripts/gh.mjs",
    "painel": "node scripts/painel.mjs",
    "site": "node scripts/site.mjs",
    "publicar-site": "node scripts/publicar-site.mjs",
    "vozes": "node scripts/vozes.mjs",
    "sons": "node scripts/sons.mjs",
    "estudio": "node scripts/estudio.mjs",
    "ouvir": "node scripts/abrir.mjs .decepticons/ouvir-sons.html",
    "mech:inspecionar": "node scripts/inspecionar-mech.mjs",
    "mech:bocas": "node scripts/medir-bocas.mjs",
    "server": "node scripts/server.mjs",
    "admin": "node scripts/admin.mjs",
    "capacity": "node scripts/capacity.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-simd": "0.20.0",
    "@dimforge/rapier3d-simd-compat": "0.20.0",
    "three": "^0.186.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.1",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^5.0.1"
  }
}
